+// Experimental: scores conversion candidates with a small conversion LM
+// (zenz-v3, via a dynamically loaded llama.cpp). Everything fails open: when
+// the runtime or the model is missing, Score() returns an empty vector.
+#ifndef MOZC_REWRITER_LLM_SCORER_H_
+#define MOZC_REWRITER_LLM_SCORER_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "absl/strings/string_view.h"
+
+namespace mozc {
+
+class LlmScorer {
+ public:
+  static LlmScorer& Instance();
+
+  // True once the model has been loaded (loading runs on a worker thread).
+  bool IsReady() const;
+
+  // Appends one line to rerank.log (no-op where logging is unavailable).
+  // Callers must pass counts and timings only, never user text.
+  void LogLine(const std::string& line);
+
+  // Returns log P(candidate | context, reading) for each candidate, in order,
+  // or an empty vector when scoring is unavailable or fails.
+  std::vector<double> Score(absl::string_view context,
+                            absl::string_view reading_hiragana,
+                            const std::vector<std::string>& candidates);
+
+  ~LlmScorer();
+
+ private:
+  LlmScorer();
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace mozc
+
+#endif  // MOZC_REWRITER_LLM_SCORER_H_
