+// Experimental: reorders the top candidates of each conversion segment by the
+// likelihood a small conversion LM (zenz) gives them after the text that
+// precedes the cursor. See rewriter/llm_scorer.h. Fails open.
+#ifndef MOZC_REWRITER_CONTEXT_RERANK_REWRITER_H_
+#define MOZC_REWRITER_CONTEXT_RERANK_REWRITER_H_
+
+#include "converter/segments.h"
+#include "request/conversion_request.h"
+#include "rewriter/rewriter_interface.h"
+
+namespace mozc {
+
+class ContextRerankRewriter : public RewriterInterface {
+ public:
+  int capability(const ConversionRequest& request) const override;
+
+  bool Rewrite(const ConversionRequest& request,
+               Segments* segments) const override;
+};
+
+}  // namespace mozc
+
+#endif  // MOZC_REWRITER_CONTEXT_RERANK_REWRITER_H_
