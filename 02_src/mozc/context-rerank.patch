@@ -0,0 +1,495 @@
+#include "rewriter/llm_scorer.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <tuple>
+#include <vector>
+
+#include "absl/strings/string_view.h"
+
+#ifdef _WIN32
+#include <windows.h>
+
+#include "llama.h"
+#endif  // _WIN32
+
+namespace mozc {
+
+#ifndef _WIN32
+
+struct LlmScorer::Impl {};
+LlmScorer::LlmScorer() : impl_(std::make_unique<Impl>()) {}
+LlmScorer::~LlmScorer() = default;
+LlmScorer& LlmScorer::Instance() {
+  static LlmScorer* instance = new LlmScorer();
+  return *instance;
+}
+bool LlmScorer::IsReady() const { return false; }
+void LlmScorer::LogLine(const std::string&) {}
+std::vector<double> LlmScorer::Score(absl::string_view,
+                                     absl::string_view,
+                                     const std::vector<std::string>&) {
+  return {};
+}
+
+#else  // _WIN32
+
+namespace {
+
+// zenz-v3 control characters (U+EE00 input, U+EE01 output, U+EE02 context).
+constexpr char kInput[] = "\xEE\x88\x80";
+constexpr char kOutput[] = "\xEE\x88\x81";
+constexpr char kContext[] = "\xEE\x88\x82";
+
+constexpr int kMaxCandidates = 8;
+constexpr int kBatch = 256;
+constexpr int kCtx = 512;
+
+std::wstring GetEnvW(const wchar_t* name) {
+  wchar_t buf[MAX_PATH * 2];
+  const DWORD n = GetEnvironmentVariableW(name, buf, MAX_PATH * 2);
+  if (n == 0 || n >= MAX_PATH * 2) return L"";
+  return std::wstring(buf, n);
+}
+
+std::string ToUtf8(const std::wstring& w) {
+  if (w.empty()) return "";
+  const int n = WideCharToMultiByte(CP_UTF8, 0, w.data(),
+                                    static_cast<int>(w.size()), nullptr, 0,
+                                    nullptr, nullptr);
+  std::string s(n, '\0');
+  WideCharToMultiByte(CP_UTF8, 0, w.data(), static_cast<int>(w.size()),
+                      s.data(), n, nullptr, nullptr);
+  return s;
+}
+
+// Hiragana -> katakana on UTF-8 (U+3041..U+3096 -> +0x60). Other text is kept.
+std::string ToKatakana(absl::string_view s) {
+  std::string out;
+  for (size_t i = 0; i < s.size();) {
+    const unsigned char c = s[i];
+    if (c == 0xE3 && i + 2 < s.size()) {
+      const uint32_t cp = ((c & 0x0F) << 12) |
+                          ((static_cast<unsigned char>(s[i + 1]) & 0x3F) << 6) |
+                          (static_cast<unsigned char>(s[i + 2]) & 0x3F);
+      if (cp >= 0x3041 && cp <= 0x3096) {
+        const uint32_t k = cp + 0x60;
+        out += static_cast<char>(0xE0 | (k >> 12));
+        out += static_cast<char>(0x80 | ((k >> 6) & 0x3F));
+        out += static_cast<char>(0x80 | (k & 0x3F));
+        i += 3;
+        continue;
+      }
+    }
+    out += s[i++];
+  }
+  return out;
+}
+
+// zenz's vocabulary has neither ASCII space nor newline.
+std::string NormalizeForZenz(absl::string_view s) {
+  std::string out;
+  for (char c : s) {
+    if (c == '\n' || c == '\r') continue;
+    if (c == ' ') {
+      out += "\xE3\x80\x80";
+    } else {
+      out += c;
+    }
+  }
+  return out;
+}
+
+void AppendLog(const std::wstring& dir, const std::string& line) {
+  const std::wstring path = dir + L"\\rerank.log";
+  HANDLE h = CreateFileW(path.c_str(), FILE_APPEND_DATA, FILE_SHARE_READ,
+                         nullptr, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+  if (h == INVALID_HANDLE_VALUE) return;
+  SYSTEMTIME t;
+  GetLocalTime(&t);
+  char head[64];
+  snprintf(head, sizeof(head), "%02d:%02d:%02d.%03d ", t.wHour, t.wMinute,
+           t.wSecond, t.wMilliseconds);
+  const std::string s = std::string(head) + line + "\r\n";
+  DWORD written = 0;
+  WriteFile(h, s.data(), static_cast<DWORD>(s.size()), &written, nullptr);
+  CloseHandle(h);
+}
+
+template <typename T>
+bool Bind(HMODULE m, const char* name, T* out) {
+  *out = reinterpret_cast<T>(GetProcAddress(m, name));
+  return *out != nullptr;
+}
+
+}  // namespace
+
+struct LlmScorer::Impl {
+  std::atomic<bool> ready{false};
+  std::mutex mu;
+  std::wstring dir;
+  // mozc_server may run at low integrity: log under LocalLow\Mozc, which it can write.
+  std::wstring log_dir;
+
+  // llama.cpp entry points (b4846).
+  decltype(&llama_model_default_params) model_default_params = nullptr;
+  decltype(&llama_context_default_params) context_default_params = nullptr;
+  decltype(&llama_model_load_from_file) model_load = nullptr;
+  decltype(&llama_init_from_model) init_from_model = nullptr;
+  decltype(&llama_model_get_vocab) get_vocab = nullptr;
+  decltype(&llama_vocab_n_tokens) n_tokens = nullptr;
+  decltype(&llama_tokenize) tokenize = nullptr;
+  decltype(&llama_batch_init) batch_init = nullptr;
+  decltype(&llama_decode) decode = nullptr;
+  decltype(&llama_get_logits_ith) get_logits = nullptr;
+  decltype(&llama_kv_cache_seq_rm) seq_rm = nullptr;
+  decltype(&llama_kv_cache_seq_cp) seq_cp = nullptr;
+  decltype(&llama_kv_cache_clear) kv_clear = nullptr;
+  decltype(&llama_set_abort_callback) set_abort = nullptr;
+  decltype(&llama_vocab_bos) vocab_bos = nullptr;
+  decltype(&llama_vocab_get_add_bos) vocab_add_bos = nullptr;
+
+  llama_model* model = nullptr;
+  llama_context* ctx = nullptr;
+  const llama_vocab* vocab = nullptr;
+  llama_batch batch{};
+  int n_vocab = 0;
+  std::vector<llama_token> bos;
+
+  // KV state of sequence 0: the token prefix and the logits after its last
+  // token. Reused across calls through the longest common prefix.
+  std::vector<llama_token> prefix;
+  std::vector<float> prefix_logits;
+
+  std::atomic<int64_t> deadline_ticks{0};
+  int deadline_ms = 250;
+
+  static int64_t Now() {
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+  }
+
+  static bool AbortCallback(void* data) {
+    auto* self = static_cast<Impl*>(data);
+    return Now() > self->deadline_ticks.load();
+  }
+
+  void InitLogDir() {
+    std::wstring local = GetEnvW(L"LOCALAPPDATA");
+    const std::wstring tail = L"\\Local";
+    if (local.size() > tail.size() &&
+        local.compare(local.size() - tail.size(), tail.size(), tail) == 0) {
+      log_dir = local + L"Low\\Mozc";
+    } else {
+      log_dir = local + L"\\MozcRerank";
+    }
+  }
+
+  void Load() {
+    InitLogDir();
+    AppendLog(log_dir, "load: starting");
+    // mozc_server runs with a restricted, low-integrity token (see
+    // client/server_launcher.cc), so user-profile paths are unreliable. Its
+    // own install directory is always readable: use <exe dir>\rerank.
+    std::wstring base = GetEnvW(L"MOZC_RERANK_DIR");
+    if (base.empty()) {
+      wchar_t exe[MAX_PATH];
+      const DWORD n = GetModuleFileNameW(nullptr, exe, MAX_PATH);
+      std::wstring path(exe, n);
+      base = path.substr(0, path.find_last_of(L'\\')) + L"\\rerank";
+    }
+    dir = base;
+    const std::wstring probe = dir + L"\\llama.dll";
+    AppendLog(log_dir, "load: dir " + ToUtf8(dir));
+    AppendLog(log_dir, std::string("load: llama.dll ") +
+                           (GetFileAttributesW(probe.c_str()) ==
+                                    INVALID_FILE_ATTRIBUTES
+                                ? "NOT visible (" +
+                                      std::to_string(GetLastError()) + ")"
+                                : "visible"));
+    const std::wstring ms = GetEnvW(L"MOZC_RERANK_DEADLINE_MS");
+    if (!ms.empty()) deadline_ms = std::max(10, _wtoi(ms.c_str()));
+
+    const std::wstring dll = dir + L"\\llama.dll";
+    // Mozc binaries link with /DEPENDENTLOADFLAG (System32 + app dir only), so
+    // the directory of llama.dll must be named explicitly for its ggml*.dll.
+    HMODULE llama = LoadLibraryExW(
+        dll.c_str(), nullptr,
+        LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_APPLICATION_DIR |
+            LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!llama) {
+      AppendLog(log_dir, "load: llama.dll not loadable (" +
+                         std::to_string(GetLastError()) + ")");
+      return;
+    }
+    // Dynamic ggml backends (ggml-cpu.dll ...) are found beside the DLLs.
+    if (HMODULE ggml = GetModuleHandleW(L"ggml.dll")) {
+      void (*load_all)(const char*) = nullptr;
+      if (Bind(ggml, "ggml_backend_load_all_from_path", &load_all)) {
+        load_all(ToUtf8(dir).c_str());
+      }
+    }
+    void (*backend_init)() = nullptr;
+    if (!(Bind(llama, "llama_model_default_params", &model_default_params) &&
+          Bind(llama, "llama_context_default_params", &context_default_params) &&
+          Bind(llama, "llama_model_load_from_file", &model_load) &&
+          Bind(llama, "llama_init_from_model", &init_from_model) &&
+          Bind(llama, "llama_model_get_vocab", &get_vocab) &&
+          Bind(llama, "llama_vocab_n_tokens", &n_tokens) &&
+          Bind(llama, "llama_tokenize", &tokenize) &&
+          Bind(llama, "llama_batch_init", &batch_init) &&
+          Bind(llama, "llama_decode", &decode) &&
+          Bind(llama, "llama_get_logits_ith", &get_logits) &&
+          Bind(llama, "llama_kv_cache_seq_rm", &seq_rm) &&
+          Bind(llama, "llama_kv_cache_seq_cp", &seq_cp) &&
+          Bind(llama, "llama_kv_cache_clear", &kv_clear) &&
+          Bind(llama, "llama_set_abort_callback", &set_abort) &&
+          Bind(llama, "llama_vocab_bos", &vocab_bos) &&
+          Bind(llama, "llama_vocab_get_add_bos", &vocab_add_bos) &&
+          Bind(llama, "llama_backend_init", &backend_init))) {
+      AppendLog(log_dir, "load: llama.dll lacks an expected export (wrong build?)");
+      return;
+    }
+    backend_init();
+
+    const std::string model_path =
+        ToUtf8(dir + L"\\ggml-model-Q5_K_M.gguf");
+    llama_model_params mp = model_default_params();
+    mp.n_gpu_layers = 0;
+    mp.use_mmap = true;
+    model = model_load(model_path.c_str(), mp);
+    if (!model) {
+      AppendLog(log_dir, "load: model not loadable");
+      return;
+    }
+    llama_context_params cp = context_default_params();
+    cp.n_ctx = kCtx;
+    cp.n_batch = kBatch;
+    cp.n_seq_max = kMaxCandidates + 1;
+    const unsigned hw = std::thread::hardware_concurrency();
+    cp.n_threads = cp.n_threads_batch =
+        static_cast<int32_t>(std::clamp<unsigned>(hw / 2, 2, 6));
+    ctx = init_from_model(model, cp);
+    if (!ctx) {
+      AppendLog(log_dir, "load: context creation failed");
+      return;
+    }
+    vocab = get_vocab(model);
+    n_vocab = n_tokens(vocab);
+    batch = batch_init(kBatch, 0, 1);
+    if (vocab_add_bos(vocab)) bos.push_back(vocab_bos(vocab));
+    set_abort(ctx, &Impl::AbortCallback, this);
+    ready.store(true);
+    AppendLog(log_dir, "load: ready (vocab " + std::to_string(n_vocab) +
+                       ", threads " + std::to_string(cp.n_threads) + ")");
+  }
+
+  std::vector<llama_token> Tok(absl::string_view text) {
+    const std::string norm = NormalizeForZenz(text);
+    std::vector<llama_token> toks(norm.size() + 8);
+    const int n = tokenize(vocab, norm.data(), static_cast<int32_t>(norm.size()),
+                           toks.data(), static_cast<int32_t>(toks.size()),
+                           /*add_special=*/false, /*parse_special=*/true);
+    if (n < 0) return {};
+    toks.resize(n);
+    return toks;
+  }
+
+  void Reset() {
+    kv_clear(ctx);
+    prefix.clear();
+    prefix_logits.clear();
+  }
+
+  bool DecodeItems(const std::vector<std::tuple<llama_token, int, int>>& items,
+                   size_t begin, size_t end) {
+    for (size_t i = begin; i < end; ++i) {
+      const auto& [tok, pos, seq] = items[i];
+      const size_t k = i - begin;
+      batch.token[k] = tok;
+      batch.pos[k] = pos;
+      batch.n_seq_id[k] = 1;
+      batch.seq_id[k][0] = seq;
+      batch.logits[k] = 1;
+    }
+    batch.n_tokens = static_cast<int32_t>(end - begin);
+    return decode(ctx, batch) == 0;
+  }
+
+  // Brings sequence 0 to `target` (context + reading), reusing the common
+  // prefix. Returns false on failure (state is reset).
+  bool Sync(const std::vector<llama_token>& target) {
+    if (target.empty() || target.size() >= static_cast<size_t>(kCtx) - 64) {
+      return false;
+    }
+    size_t lcp = 0;
+    while (lcp < std::min(target.size(), prefix.size()) &&
+           target[lcp] == prefix[lcp]) {
+      ++lcp;
+    }
+    if (lcp == target.size() && lcp == prefix.size() && !prefix_logits.empty()) {
+      return true;
+    }
+    lcp = std::min(lcp, target.size() - 1);  // the last logits are needed
+    if (lcp < prefix.size() &&
+        !seq_rm(ctx, 0, static_cast<llama_pos>(lcp), -1)) {
+      Reset();
+      lcp = 0;
+    }
+    std::vector<std::tuple<llama_token, int, int>> items;
+    for (size_t i = lcp; i < target.size(); ++i) {
+      items.emplace_back(target[i], static_cast<int>(i), 0);
+    }
+    size_t last_n = 0;
+    for (size_t s = 0; s < items.size(); s += kBatch) {
+      const size_t e = std::min(items.size(), s + kBatch);
+      if (!DecodeItems(items, s, e)) {
+        Reset();
+        return false;
+      }
+      last_n = e - s;
+    }
+    const float* row = get_logits(ctx, static_cast<int32_t>(last_n) - 1);
+    if (!row) {
+      Reset();
+      return false;
+    }
+    prefix_logits.assign(row, row + n_vocab);
+    prefix = target;
+    return true;
+  }
+
+  double LogProb(const float* logits, llama_token tok) const {
+    float mx = logits[0];
+    for (int i = 1; i < n_vocab; ++i) mx = std::max(mx, logits[i]);
+    double sum = 0;
+    for (int i = 0; i < n_vocab; ++i) sum += std::exp(logits[i] - mx);
+    return static_cast<double>(logits[tok]) - mx - std::log(sum);
+  }
+
+  std::vector<double> Rank(absl::string_view context, absl::string_view reading,
+                           const std::vector<std::string>& candidates) {
+    if (candidates.empty() || candidates.size() > kMaxCandidates) return {};
+    deadline_ticks.store(Now() + deadline_ms * 1000);
+
+    std::vector<llama_token> target = bos;
+    if (!context.empty()) {
+      const auto head = Tok(std::string(kContext) + std::string(context));
+      target.insert(target.end(), head.begin(), head.end());
+    }
+    const auto tail =
+        Tok(std::string(kInput) + ToKatakana(reading) + std::string(kOutput));
+    target.insert(target.end(), tail.begin(), tail.end());
+    if (!Sync(target)) return {};
+
+    const int base = static_cast<int>(prefix.size());
+    std::vector<std::vector<llama_token>> toks;
+    std::vector<std::tuple<llama_token, int, int>> items;
+    std::vector<size_t> first_row;
+    // Tokenize everything before branching, so that a failure here leaves no
+    // half-copied sequences behind in the KV cache.
+    for (const std::string& c : candidates) {
+      toks.push_back(Tok(c));
+      if (toks.back().empty()) return {};
+    }
+    for (size_t i = 0; i < candidates.size(); ++i) {
+      seq_cp(ctx, 0, static_cast<llama_seq_id>(i + 1), -1, -1);
+      first_row.push_back(items.size());
+      for (size_t k = 0; k + 1 < toks[i].size(); ++k) {
+        items.emplace_back(toks[i][k], base + static_cast<int>(k),
+                           static_cast<int>(i + 1));
+      }
+    }
+    auto cleanup = [&]() {
+      for (size_t i = 0; i < candidates.size(); ++i) {
+        seq_rm(ctx, static_cast<llama_seq_id>(i + 1), -1, -1);
+      }
+    };
+    if (items.size() > static_cast<size_t>(kBatch)) {
+      cleanup();
+      return {};
+    }
+    if (!items.empty() && !DecodeItems(items, 0, items.size())) {
+      cleanup();
+      Reset();
+      return {};
+    }
+    std::vector<double> scores;
+    for (size_t i = 0; i < candidates.size(); ++i) {
+      double lp = LogProb(prefix_logits.data(), toks[i][0]);
+      for (size_t k = 1; k < toks[i].size(); ++k) {
+        const float* row =
+            get_logits(ctx, static_cast<int32_t>(first_row[i] + k - 1));
+        if (!row) {
+          cleanup();
+          Reset();
+          return {};
+        }
+        lp += LogProb(row, toks[i][k]);
+      }
+      scores.push_back(lp);
+    }
+    cleanup();
+    return scores;
+  }
+};
+
+LlmScorer::LlmScorer() : impl_(std::make_unique<Impl>()) {
+  // Load on a worker thread so that the first conversion is never blocked by
+  // reading the model.
+  Impl* impl = impl_.get();
+  impl->InitLogDir();
+  std::thread([impl]() { impl->Load(); }).detach();
+}
+
+LlmScorer::~LlmScorer() = default;
+
+LlmScorer& LlmScorer::Instance() {
+  static LlmScorer* instance = new LlmScorer();  // intentionally leaked
+  return *instance;
+}
+
+void LlmScorer::LogLine(const std::string& line) {
+  AppendLog(impl_->log_dir, line);
+}
+
+bool LlmScorer::IsReady() const {
+  if (impl_->ready.load()) return true;
+  static std::atomic<int> calls{0};
+  if (calls.fetch_add(1) % 50 == 0) {
+    AppendLog(impl_->log_dir, "rewrite: scorer not ready");
+  }
+  return false;
+}
+
+std::vector<double> LlmScorer::Score(
+    absl::string_view context, absl::string_view reading_hiragana,
+    const std::vector<std::string>& candidates) {
+  if (!impl_->ready.load()) return {};
+  std::lock_guard<std::mutex> lock(impl_->mu);
+  const int64_t t0 = Impl::Now();
+  std::vector<double> r = impl_->Rank(context, reading_hiragana, candidates);
+  const int64_t ms = (Impl::Now() - t0) / 1000;
+  AppendLog(impl_->log_dir, "score: ctx " + std::to_string(context.size()) +
+                            "B, reading " +
+                            std::to_string(reading_hiragana.size()) +
+                            "B, cands " + std::to_string(candidates.size()) +
+                            " -> " + (r.empty() ? "FAILED" : "ok") + " in " +
+                            std::to_string(ms) + "ms");
+  return r;
+}
+
+#endif  // _WIN32
+
+}  // namespace mozc
