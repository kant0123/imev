diff --git a/src/rewriter/context_rerank_rewriter.cc b/src/rewriter/context_rerank_rewriter.cc
new file mode 100644
index 0000000..9eb7ce0
--- /dev/null
+++ b/src/rewriter/context_rerank_rewriter.cc
@@ -0,0 +1,169 @@
+#include "rewriter/context_rerank_rewriter.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include "absl/strings/string_view.h"
+#include "base/util.h"
+#include "converter/candidate.h"
+#include "converter/segments.h"
+#include "request/conversion_request.h"
+#include "rewriter/llm_scorer.h"
+#include "rewriter/rewriter_interface.h"
+
+namespace mozc {
+namespace {
+
+// Candidates considered per segment (matches UserSegmentHistoryRewriter).
+constexpr size_t kMaxRerankSize = 5;
+// Mozc costs are -500 * log(prob), so the LM score lives in the same unit.
+constexpr double kCostPerNat = 500.0;
+// Keeps Mozc's own order when the LM is not clearly in favour of a change.
+constexpr double kDefaultRankPrior = 300.0;
+constexpr size_t kMaxContextChars = 48;
+
+double RankPrior() {
+  static const double prior = [] {
+    const char* v = std::getenv("MOZC_RERANK_PRIOR");
+    return v ? std::atof(v) : kDefaultRankPrior;
+  }();
+  return prior;
+}
+
+// Last `n` code points of a UTF-8 string.
+std::string Tail(absl::string_view s, size_t n) {
+  size_t count = 0;
+  size_t pos = s.size();
+  while (pos > 0 && count < n) {
+    --pos;
+    while (pos > 0 && (static_cast<unsigned char>(s[pos]) & 0xC0) == 0x80) {
+      --pos;
+    }
+    ++count;
+  }
+  return std::string(s.substr(pos));
+}
+
+// Diagnostic log lines carry counts and scores only, never user text.
+std::string JoinNumbers(const std::vector<double>& v) {
+  std::string out;
+  for (size_t i = 0; i < v.size(); ++i) {
+    char buf[32];
+    snprintf(buf, sizeof(buf), "%s%.1f", i ? "," : "", v[i]);
+    out += buf;
+  }
+  return out;
+}
+
+std::string JoinSizes(const std::vector<size_t>& v) {
+  std::string out;
+  for (size_t i = 0; i < v.size(); ++i) {
+    out += (i ? "," : "") + std::to_string(v[i]);
+  }
+  return out;
+}
+
+}  // namespace
+
+int ContextRerankRewriter::capability(const ConversionRequest& request) const {
+  return CONVERSION;
+}
+
+bool ContextRerankRewriter::Rewrite(const ConversionRequest& request,
+                                    Segments* segments) const {
+  LlmScorer& scorer = LlmScorer::Instance();
+  if (!scorer.IsReady() || segments->conversion_segments_size() == 0) {
+    return false;
+  }
+
+  // Text left of the cursor, else the committed history segments.
+  std::string context = request.GetSurroundingContext().first;
+  const char* source = "surrounding";
+  if (context.empty()) {
+    source = "history";
+    for (size_t i = 0; i < segments->history_segments_size(); ++i) {
+      const Segment& h = segments->segment(i);
+      if (h.candidates_size() > 0) context += h.candidate(0).value;
+    }
+  }
+  context = Tail(context, kMaxContextChars);
+  scorer.LogLine(std::string("rewrite: ctx src=") + source + " " +
+                 std::to_string(context.size()) + "B, segs " +
+                 std::to_string(segments->conversion_segments_size()));
+  // Without context the LM only duplicates Mozc's own language model.
+  if (context.empty()) return false;
+
+  bool changed = false;
+  for (size_t si = 0; si < segments->conversion_segments_size(); ++si) {
+    Segment* seg = segments->mutable_conversion_segment(si);
+    const size_t k = std::min(seg->candidates_size(), kMaxRerankSize);
+    if (seg->segment_type() == Segment::FIXED_VALUE || k < 2 ||
+        Util::GetScriptType(seg->key()) != Util::HIRAGANA) {
+      scorer.LogLine("seg " + std::to_string(si) + " skip: " +
+                     (seg->segment_type() == Segment::FIXED_VALUE
+                          ? "fixed"
+                          : k < 2 ? "one candidate" : "key not hiragana"));
+      if (seg->candidates_size() > 0) context += seg->candidate(0).value;
+      continue;
+    }
+
+    // Pure kana candidates stay where Mozc put them: the prompt carries the
+    // reading in katakana, so the LM over-rewards copying it verbatim.
+    std::vector<size_t> slots;
+    for (size_t i = 0; i < k; ++i) {
+      const Util::ScriptType t = Util::GetScriptType(seg->candidate(i).value);
+      if (t != Util::KATAKANA && t != Util::HIRAGANA) slots.push_back(i);
+    }
+    const size_t n = slots.size();
+    if (n < 2) {
+      scorer.LogLine("seg " + std::to_string(si) + " skip: kana-only cands");
+      context += seg->candidate(0).value;
+      continue;
+    }
+
+    std::vector<std::string> values;
+    for (size_t i : slots) values.push_back(seg->candidate(i).value);
+    // Earlier segments of this conversion were appended; keep the window bounded.
+    context = Tail(context, kMaxContextChars);
+    const std::vector<double> lp = scorer.Score(context, seg->key(), values);
+    if (lp.size() != n) {
+      context += seg->candidate(0).value;
+      continue;
+    }
+
+    std::vector<size_t> order(n);
+    for (size_t j = 0; j < n; ++j) order[j] = j;
+    std::vector<double> final_cost(n);
+    for (size_t j = 0; j < n; ++j) {
+      final_cost[j] =
+          -kCostPerNat * lp[j] + RankPrior() * static_cast<double>(slots[j]);
+    }
+    std::stable_sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+      return final_cost[a] < final_cost[b];
+    });
+
+    // slots: Mozc rank of each scored candidate; lp: LM log-prob; cost: the
+    // combined score (lower wins); order: new position -> index into slots.
+    scorer.LogLine("seg " + std::to_string(si) + " rerank: slots " +
+                   JoinSizes(slots) + " lp " + JoinNumbers(lp) + " cost " +
+                   JoinNumbers(final_cost) + " order " + JoinSizes(order));
+
+    // Reorder only within the eligible slots; kana candidates keep their index.
+    std::vector<converter::Candidate> picked;
+    for (size_t j = 0; j < n; ++j) picked.push_back(seg->candidate(slots[order[j]]));
+    for (size_t j = 0; j < n; ++j) {
+      if (order[j] != j) {
+        *seg->mutable_candidate(static_cast<int>(slots[j])) = picked[j];
+        changed = true;
+      }
+    }
+    context += seg->candidate(0).value;
+  }
+  return changed;
+}
+
+}  // namespace mozc
